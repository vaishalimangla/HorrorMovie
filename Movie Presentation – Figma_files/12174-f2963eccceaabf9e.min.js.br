}`,i=`import { useState, type CSSProperties, type PointerEvent } from "react";

export default function App() {
  const [hovering, setHovering] = useState(false);
  const [cursor, setCursor] = useState({ x: 0, y: 0 });

  const handlePointerMove = (event: PointerEvent<HTMLDivElement>) => {
    const rect = event.currentTarget.getBoundingClientRect();
    setCursor({ x: event.clientX - rect.left, y: event.clientY - rect.top });
  };

  // The hover layer is the same dot grid scaled up, revealed only within a soft
  // circle that follows the cursor \u{2014} so dots appear to bloom under the pointer.
  const mask = \`radial-gradient(circle at $\{cursor.x}px $\{cursor.y}px, #000 72px, transparent 120px)\`;

  const container: CSSProperties = {
    position: "relative",
    width: "100%",
    height: "100%",
    overflow: "hidden",
    backgroundColor: "#f8fbff",
  };
  const dots: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 1.2px, transparent 1.4px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
  };
  const dotsHover: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 2.16px, transparent 2.36px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
    opacity: hovering ? 1 : 0,
    maskImage: mask,
    WebkitMaskImage: mask,
  };

  return (
    <div
      style={container}
      onPointerEnter={() => setHovering(true)}
      onPointerMove={handlePointerMove}
      onPointerLeave={() => setHovering(false)}
    >
      <div style={dots} />
      <div style={dotsHover} />
    </div>
  );
}`;n.d(t,{},{Ar:"/src/styles/index.css",DZ:"/styles/globals.css",VY:"/src/styles/theme.css",eu:"/src/styles",jP:r,oA:i})},735077(e,t,n){var r=n(821415),i=n(24260);let a=r.Ik({id:r.Yj(),url:r.Yj(),publicId:r.Yj(),type:r.Yj(),width:r.ai().optional(),height:r.ai().optional(),thumbnailUrl:r.Yj().optional(),viewUrl:r.Yj().optional(),originalUrl:r.Yj().optional()}),o=r.Ik({url:r.Yj(),type:r.Yj(),kind:r.k5(["image","video","audio","3d"]).optional()}),s=r.YO(r.Yj()),l=r.Ik({options:s}),c=r.KC([r.Ik({prompt:r.Yj()}),r.Ik({string:r.Yj()}),r.Ik({file:a}),r.Ik({files:r.YO(o)}),l,i.X_,r.YO(r.Yj()),r.Yj(),r.ai(),r.zM(),r.g1(r.L5())]),d=r.Ik({nodeId:r.Yj(),input:c,disabled:r.zM().optional(),name:r.Yj().optional()}),u=r.Ik({id:r.Yj(),inputs:r.YO(d),numberOfRuns:r.ai().optional(),recipeVersion:r.ai().optional(),generationInfo:r.Ik({userActionId:r.Yj().uuid(),iterationId:r.Yj().uuid(),targetNodeGuids:r.YO(r.Yj()),jobName:r.Yj(),requestParams:r.g1(r.L5())}).optional()});r.Ik({runIds:r.YO(r.Yj()),estimatedRuntimeSeconds:r.ai().nonnegative().nullable().optional()}),n.d(t,{},{Ef:c,Jg:s,oR:u})},811524(e,t,n){var r,i,a=n(821415),o=n(735077),s=((r={}).IMAGE="image",r.VIDEO="video",r.TEXT="text",r);let l=a.Ik({id:a.Yj().optional(),name:a.Yj().optional(),input:o.Ef.optional()}),c=l.extend({type:a.eu("image"),url:a.Yj(),width:a.ai(),height:a.ai(),viewUrl:a.Yj().optional(),publicId:a.Yj().optional(),thumbnailUrl:a.Yj().optional(),originalUrl:a.Yj().optional()}),d=l.extend({type:a.eu("video"),url:a.Yj(),width:a.ai(),height:a.ai(),fps:a.ai().optional(),duration:a.ai().optional(),viewUrl:a.Yj().optional(),publicId:a.Yj().optional(),thumbnailUrl:a.Yj().optional(),originalUrl:a.Yj().optional()}),u=l.extend({type:a.eu("text"),value:a.Yj()}),p=a.gM("type",[c,d,u]);var m=((i={}).RUNNING="RUNNING",i.COMPLETED="COMPLETED",i.FAILED="FAILED",i.CANCELED="CANCELED",i);let h=a.Ik({runs:a.g1(a.gM("status",[a.Ik({status:a.eu("RUNNING"),progress:a.ai(),outputCount:a.ai().optional()}),a.Ik({status:a.eu("COMPLETED